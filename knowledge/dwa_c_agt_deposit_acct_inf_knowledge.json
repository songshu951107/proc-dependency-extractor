      "originalTables": ["F_AC_CRBS_DEPOSIT_ACCT", "F_EV_CRBS_AGR_DEPOSIT_BOOK", "F_AC_CRBS_DEPOSIT_ACCT_INT_RATE_DEF", "F_PT_ECIF_WHOLE_BANK_CUST_INF"],
      "tableJoinLogic": "整合临时表数据，关联会计分录配置、业务代码、协定存款信息、利率信息、客户信息，插入存款账户汇总表",
      "queryDimensions": "账号、客户号、利率、余额、利息",
      "tags": ["存款汇总", "账户余额", "利息计算"],
      "derivedKnowledge": [
        {
          "knowledgeName": "存款账户客户类型判断",
          "derivedSql": "SELECT T1.DPACNO, CASE WHEN T1.PRCLS1 = '2' AND T2.govern_structure = '1' THEN '0202' WHEN T1.PRCLS1 = '2' AND NVL(T2.govern_structure,'') <> '1' THEN '0201' WHEN T1.PRCLS1 = '1' THEN '01' WHEN T1.PRCLS1 = '3' THEN '03' END AS cust_type FROM O_CRBS_ADPXX T1 LEFT JOIN O_ECIF_M_CI_CUSTOMER T2 ON T1.CUSNUM = T2.core_no",
          "businessMeaning": "根据产品分类和政务客户标志判断客户类型：政务、公司、个人、同业",
          "sourceTable": "O_CRBS_ADPXX",
          "originalTable": "F_AC_CRBS_DEPOSIT_ACCT"
        },
        {
          "knowledgeName": "存款账户业务类型计算",
          "derivedSql": "SELECT DPACNO, CASE WHEN MOD(CAST(ACTTCD AS INT),10) = 1 AND DPZHZT IN ('I','D') THEN CASE DPZHZT WHEN 'D' THEN 'XA-DPBDHKM' WHEN 'I' THEN 'XA-DPYYWKM' END ELSE '1' || CASE SUBSTR(ACTTCD,2,1) WHEN '0' THEN TRIM(ACTCD1)||TRIM(ACTCD2) WHEN '2' THEN TRIM(ACTCD1) WHEN '3' THEN TRIM(ACTCD2) END || '-' || 'LDGBAL' END AS biz_type FROM O_CRBS_ADPXX",
          "businessMeaning": "根据会计核算类型代码和账户分类代码计算业务类型",
          "sourceTable": "O_CRBS_ADPXX",
          "originalTable": "F_AC_CRBS_DEPOSIT_ACCT"
        }
      ]
    },

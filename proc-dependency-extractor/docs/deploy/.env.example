# =====================================================================
# proc-dependency-extractor 内网部署环境变量模板（复制为 .env 后填入真实值）
# 用法：source .env 后运行 start.sh，或由 pde.service 加载本文件
# =====================================================================

# MySQL 连接
SPRING_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3306/proc_extractor?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true'
SPRING_DATASOURCE_USERNAME=pde
SPRING_DATASOURCE_PASSWORD='请改成强密码'

# Neo4j 连接
SPRING_NEO4J_URI='bolt://127.0.0.1:7687'
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD='请改成强密码'

# 脚本 / 报表 / DDL 目录（按内网实际路径填写）
EXTRACTOR_REPORT_DIR='/data/pde/reports'
EXTRACTOR_DDL_DIR='/data/pde/jiaoben'
EXTRACTOR_DDL_EXCEL_PATH='/data/pde/jiaoben/columns0818.xlsx'

# 应用端口（可选，默认 8080）
SERVER_PORT=8080

# AI 问数（nl2sql）—— 内网不启用可留空或删掉
# NL2SQL_API_KEY=''
# NL2SQL_BASE_URL='http://内网llm网关/v1'